{
  "schema_version": "1.0.0",
  "reviewed_at": "2026-08-28",
  "authority": "Official",
  "source": {
    "id": "inventory-search",
    "title": "Searching & Filtering your Pokémon Inventory",
    "url": "https://niantic.helpshift.com/hc/en/6-pokemon-go/faq/1486-searching-filtering-your-pokemon-inventory/",
    "reviewed_at": "2026-08-28"
  },
  "boolean": {
    "and": ["&"],
    "or": ["|", ",", ":", ";"],
    "not": "!",
    "grouping_supported": false,
    "note": "The reviewed official source documents flat AND/OR/exclusion syntax but does not document parenthesized grouping."
  },
  "range": {
    "exact": "prefixN",
    "maximum": "prefix-N",
    "minimum": "prefixN-",
    "between": "prefixN-M",
    "documented_for": ["cp", "hp", "distance"]
  },
  "operators": [
    {"id":"cp","label":"Combat Power","kind":"numeric-range-prefix","prefix":"cp","examples":["cp300","cp-300","cp300-","cp200-300"]},
    {"id":"distance","label":"Catch distance","kind":"numeric-range-prefix","prefix":"distance","examples":["distance1000","distance1000-","distance1000-1200"]},
    {"id":"dynamax","label":"Dynamax Pokémon","kind":"bare","tokens":["dynamax"]},
    {"id":"family","label":"Evolutionary family","kind":"prefixed-value","prefix":"+","examples":["+Pikachu"]},
    {"id":"fusion","label":"Fusion Pokémon","kind":"bare","tokens":["fusion"]},
    {"id":"gigantamax","label":"Gigantamax Pokémon","kind":"bare","tokens":["gigantamax"]},
    {"id":"hp","label":"Health Points","kind":"numeric-range-prefix","prefix":"hp","examples":["hp150","hp-150","hp150-","hp100-150"]},
    {"id":"size","label":"Size category","kind":"bare","tokens":["xl","xs","xxl","xxs"]},
    {"id":"megaevolve","label":"Mega/Primal eligible now","kind":"bare","tokens":["megaevolve"]},
    {"id":"megalevel","label":"Mega Level","kind":"enum-pattern","pattern":"^mega(?:[1-3]|[1-3]-[1-3])$","examples":["mega1","mega2-3"]},
    {"id":"move","label":"Move name/type","kind":"prefixed-value","prefix":"@","examples":["@scratch","@grass"]},
    {"id":"move-slot","label":"Fast/Charged move slot","kind":"prefixed-value-pattern","pattern":"^@[123].+$","examples":["@1fire","@2shadow ball","@3ghost"]},
    {"id":"name-or-nickname","label":"Pokémon name or nickname","kind":"free-text","note":"Bare text can match species names, nicknames, types, regions, and other documented bare terms. The app does not pretend it can distinguish those interpretations without context."},
    {"id":"dex","label":"Pokédex number","kind":"integer-bare","minimum":1,"examples":["25"]},
    {"id":"type","label":"Pokémon type","kind":"enum-bare","tokens":["bug","dark","dragon","electric","fairy","fighting","fire","flying","ghost","grass","ground","ice","normal","poison","psychic","rock","steel","water"]},
    {"id":"region","label":"Region","kind":"enum-bare","tokens":["kanto","johto","hoenn","sinnoh","unova","galar","hisui","paldea","alola","kalos"]},
    {"id":"special-move","label":"Special move","kind":"bare","tokens":["@special"]},
    {"id":"age","label":"Catch age in days","kind":"integer-prefix","prefix":"age","minimum":0,"examples":["age0","age1"]},
    {"id":"buddy","label":"Buddy level","kind":"enum-pattern","pattern":"^buddy[0-5]$","examples":["buddy0","buddy5"]},
    {"id":"evolve","label":"Currently evolvable","kind":"bare","tokens":["evolve"]},
    {"id":"favorite","label":"Favorite","kind":"bare","tokens":["favorite"]},
    {"id":"defender","label":"Gym defender","kind":"bare","tokens":["defender"]},
    {"id":"hypertraining","label":"Hyper Training","kind":"bare","tokens":["hypertraining"]},
    {"id":"item","label":"Item-based evolution","kind":"bare","tokens":["item"]},
    {"id":"evolvenew","label":"New Pokédex evolution","kind":"bare","tokens":["evolvenew"]},
    {"id":"evolvequest","label":"Quest-based evolution","kind":"bare","tokens":["evolvequest"]},
    {"id":"tradeevolve","label":"Trade evolution","kind":"bare","tokens":["tradeevolve"]},
    {"id":"weather","label":"Weather-boosted move","kind":"bare","tokens":["@weather"]},
    {"id":"year","label":"Acquisition year","kind":"integer-prefix","prefix":"year","minimum":2016,"examples":["year2016"]},
    {"id":"appraisal","label":"Appraisal stars","kind":"enum-pattern","pattern":"^[0-4]\\*$","examples":["0*","3*","4*"]},
    {"id":"attribute-appraisal","label":"Attack/Defense/HP appraisal band","kind":"enum-pattern","pattern":"^[0-4](?:attack|defense|hp)$","examples":["1attack","2defense","3hp"]},
    {"id":"eggsonly","label":"Egg-exclusive","kind":"bare","tokens":["eggsonly"]},
    {"id":"hatched","label":"Hatched","kind":"bare","tokens":["hatched"]},
    {"id":"lucky","label":"Lucky","kind":"bare","tokens":["lucky"]},
    {"id":"legendary","label":"Legendary","kind":"bare","tokens":["legendary"]},
    {"id":"mythical","label":"Mythical","kind":"bare","tokens":["mythical"]},
    {"id":"background","label":"Background","kind":"bare","tokens":["background","locationbackground"]},
    {"id":"purified","label":"Purified","kind":"bare","tokens":["purified"]},
    {"id":"shadow","label":"Shadow","kind":"bare","tokens":["shadow"]},
    {"id":"shiny","label":"Shiny","kind":"bare","tokens":["shiny"]},
    {"id":"costume","label":"Costume/Special Event","kind":"bare","tokens":["costume"]},
    {"id":"tag","label":"Tag","kind":"prefixed-value","prefix":"#","examples":["#battle"]},
    {"id":"traded","label":"Received in trade","kind":"bare","tokens":["traded"]},
    {"id":"ultrabeast","label":"Ultra Beast","kind":"bare","tokens":["ultrabeast","ultra beasts"]}
  ],
  "maintenance": {
    "mechanics_domain": "inventory-search",
    "change_detection": "knowledge/mechanics-registry.json source watch",
    "fail_closed_on_unknown_operator": true,
    "verified_exact_requires_fixture_match": true
  }
}
