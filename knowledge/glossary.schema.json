{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stevenfarless.github.io/pokemon-go-collection/data/knowledge/glossary.schema.json",
  "title": "Contextual Pokémon GO glossary",
  "type": "object",
  "required": ["schema_version", "dataset_version", "reviewed_at", "purpose", "entries"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "dataset_version": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date"},
    "purpose": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "term", "aliases", "definition", "why_it_matters", "classification", "source_resource"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "term": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "definition": {"type": "string", "minLength": 1},
          "why_it_matters": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "minLength": 1},
          "source_resource": {"type": "string", "pattern": "^data/(?:[^/]+/)*[^/]+$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
